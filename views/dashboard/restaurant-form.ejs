<section class="page-head">
  <h1><%= restaurant ? 'Edit' : 'New' %> Restaurant</h1>
</section>

<section class="card">
  <form method="post" action="<%= restaurant ? `/admin/restaurants/${restaurant.id}` : '/admin/restaurants' %>" class="form">
    <div class="grid-2">
      <label>Name
        <input type="text" name="name" value="<%= restaurant?.name || '' %>" required>
      </label>
      <label>Slug
        <input type="text" name="slug" value="<%= restaurant?.slug || '' %>" required pattern="[a-z0-9-]+">
      </label>
      <label>Phone
        <input type="text" name="phone" value="<%= restaurant?.phone || '' %>">
      </label>
      <label>Address
        <input type="text" name="address" value="<%= restaurant?.address || '' %>">
      </label>
      <% if (restaurant) { %>
        <label>Status
          <select name="status">
            <option value="active" <%= restaurant.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="suspended" <%= restaurant.status === 'suspended' ? 'selected' : '' %>>Suspended</option>
          </select>
        </label>
      <% } %>
    </div>

    <% if (!restaurant) { %>
      <h3>Admin account</h3>
      <div class="grid-2">
        <label>Admin Email
          <input type="email" name="admin_email" required>
        </label>
        <label>Admin Password
          <input type="password" name="admin_password" required minlength="6">
        </label>
      </div>
    <% } %>

    <button class="btn btn-primary" type="submit"><%= restaurant ? 'Save Changes' : 'Create Restaurant' %></button>
  </form>
</section>

<% if (restaurant) { %>
  <section class="card">
    <h2>QR Code</h2>
    <form method="post" action="/admin/restaurants/<%= restaurant.id %>/qr" class="inline-form">
      <input type="text" name="table_number" placeholder="Table number (optional)">
      <button class="btn" type="submit">Generate QR</button>
    </form>
    <p><a href="/r/<%= restaurant.slug %>" target="_blank">Preview public menu →</a></p>
  </section>
<% } %>